{
  "build": {
    "content": [
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "template": [
      "default",
      "modern",
      "theme"
    ],
    "globalMetadata": {
      "_appName": "Ben Mazzarol",
      "_appTitle": "Ben Mazzarol",
      "_appLogoPath": "images/fire-icon.png",
      "_appFaviconPath": "images/favicon.ico",
      "_appFooter": "Built with <a href='https://dotnet.github.io/docfx'>docfx</a> from <a href='https://github.com/bmazzarol/bmazzarol'>this monorepo</a>",
      "_enableSearch": true
    }
  }
}
